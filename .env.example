# ============================================================================
# AI Money Mentor - Multi-Provider LLM Configuration
# ============================================================================
# This project supports multiple FREE and freemium LLM providers to avoid
# single-point dependency on expensive APIs (like OpenAI).
#
# Priority order for provider fallback:
# 1. Groq (Recommended - FREE with generous limits)
# 2. Together AI (FREE tier available)
# 3. HuggingFace (FREE inference API)
# 4. OpenAI (Fallback only - requires paid quota)
# ============================================================================

# ============ PRIMARY PROVIDER SELECTION ============
# Set the primary LLM provider to use (groq, together, huggingface, openai)
# If primary provider fails, automatically falls back to next available
AI_PROVIDER=groq

# ============ GROQ API (RECOMMENDED - FREE) ============
# Sign up: https://console.groq.com
# Free tier: 30 requests per minute (excellent for most use cases)
# Models: mixtral-8x7b-32768, llama2-70b, etc.
# Why Groq? Fastest inference speeds, free tier, no quota limits
GROQ_API_KEY=your-groq-api-key-here

# ============ TOGETHER AI (FREE TIER) ============
# Sign up: https://www.together.ai
# Free tier: $5 monthly credits (sufficient for most projects)
# Multiple open-source models available
# Good fallback if Groq is unavailable
TOGETHER_API_KEY=your-together-api-key-here

# ============ HUGGINGFACE (FREE) ============
# Sign up: https://huggingface.co
# Free inference API (with rate limits)
# Large model selection
# Good third-level fallback
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ============ OPENAI (PAID - FALLBACK ONLY) ============
# This is now used ONLY as a fallback when free providers are unavailable
# Only set this if you have active quota
# Consider this as a safety net, not primary
OPENAI_API_KEY=your-openai-api-key-here

# ============ APPLICATION SETTINGS ============
DEBUG=false
LOG_LEVEL=INFO
